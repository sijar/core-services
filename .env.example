POSTGRES_DB=core_services
POSTGRES_ADMIN_USER=core_services_admin
# Generate three distinct hex passwords (for example: openssl rand -hex 32).
POSTGRES_ADMIN_PASSWORD=replace-with-a-random-hex-password
POSTGRES_MIGRATOR_USER=core_services_migrator
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-random-hex-password
POSTGRES_APP_USER=core_services_app
POSTGRES_APP_PASSWORD=replace-with-a-random-hex-password
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/core_services
DATABASE_USERNAME=core_services_app
DATABASE_PASSWORD=copy-the-POSTGRES_APP_PASSWORD-value-here
FLYWAY_USERNAME=core_services_migrator
FLYWAY_PASSWORD=copy-the-POSTGRES_MIGRATOR_PASSWORD-value-here

# Required in the prod profile; generate independently from the database password.
OTP_HMAC_SECRET=replace-with-at-least-32-random-bytes
APP_BASE_URL=https://your-app.example
PAYMENT_SUCCESS_URL=https://your-app.example/?payment=success
PAYMENT_CANCEL_URL=https://your-app.example/?payment=cancelled
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
SMTP_HOST=smtp.example
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@example.com
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM=replace-me
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
